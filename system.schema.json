{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Playlist Battle system description",
  "type": "object",
  "additionalProperties": false,
  "required": ["student", "prefix", "public_url", "ui", "azure", "services"],
  "properties": {
    "student": { "type": "string", "pattern": "^[a-z0-9.]+$" },
    "prefix": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "public_url": { "type": "string", "pattern": "^https://" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "static_web_app", "calls"],
      "properties": {
        "path": { "type": "string" },
        "static_web_app": { "type": "string" },
        "calls": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_group", "container_apps_environment", "sql_server", "registry"],
      "properties": {
        "resource_group": { "enum": ["rg-sdd-3a", "rg-sdd-3b"] },
        "container_apps_environment": { "type": "string" },
        "sql_server": { "type": "string" },
        "registry": { "type": "string" }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": { "$ref": "#/$defs/service" }
    }
  },
  "$defs": {
    "env_var": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "default": { "type": ["string", "number", "boolean"] },
        "secret": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "if": { "properties": { "secret": { "const": true } }, "required": ["secret"] },
      "then": { "not": { "required": ["default"] } }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "url_env", "endpoints", "timeout_s", "on_failure"],
      "properties": {
        "service": { "type": "string" },
        "url_env": { "type": "string" },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /" }
        },
        "timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "on_failure": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "path", "openapi", "port_default", "health", "migrations", "env", "calls", "azure"],
      "properties": {
        "description": { "type": "string" },
        "path": { "type": "string" },
        "openapi": { "type": "string" },
        "port_default": { "type": "integer" },
        "health": { "type": "string", "const": "/health" },
        "migrations": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "$ref": "#/$defs/env_var" } },
        "calls": { "type": "array", "items": { "$ref": "#/$defs/call" } },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["container_app", "sql_database"],
          "properties": {
            "container_app": { "type": "string" },
            "sql_database": { "type": "string" }
          }
        }
      }
    }
  }
}
